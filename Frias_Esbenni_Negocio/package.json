{
  "name": "la-profe-papeleria",
  "version": "1.0.0",
  "description": "Sitio web de Papeleria y Merceria La Profe con API y pruebas automatizadas con Playwright",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}